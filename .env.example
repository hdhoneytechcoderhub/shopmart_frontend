# Vite frontend configuration.
# Copy to .env and adjust. Only VITE_* values are exposed to the browser, so
# NEVER put the Razorpay key secret here — it belongs to the backend only.

# Base path for the Spring Boot API. The dev server proxies /api to
# VITE_API_TARGET, so keeping "/api" works locally and behind a reverse proxy.
VITE_API_BASE_URL=/api

# Backend origin used by the Vite dev proxy.
VITE_API_TARGET=shopmartfrontend-production.up.railway.app

# Demo mode is a UI-only walkthrough of the catalog/dashboard. Checkout,
# payments and orders require the real backend, so keep this false for testing
# the payment flow.
VITE_DEMO_MODE=false

# Optional fallback publishable key id. The backend returns the configured key
# id with every Razorpay order; leave this empty unless you need a fallback.
VITE_RAZORPAY_KEY_ID=rzp_test_SgtqsE7TSKJRD9
